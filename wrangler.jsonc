{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runecaster",
  "main": "worker/index.js",
  "account_id": "c54acccac3bf2f1e3724dfb912e242e3", // not a secret; CI needs only CLOUDFLARE_API_TOKEN
  "compatibility_date": "2026-10-03",
  "routes": [{ "pattern": "runecaster.net", "custom_domain": true }],
  "workers_dev": false, // runecaster.net is the only address
  "preview_urls": false,
  // the game is static; only the score API runs code
  "assets": {
    "directory": "./prototype",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runecaster",
      "database_id": "a31da316-67c4-4ece-8d7a-45b3f3b81cc9",
      "migrations_dir": "migrations"
    }
  ],
  // score posts per IP: 5 a minute per Cloudflare location
  "ratelimits": [
    { "name": "RATE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
